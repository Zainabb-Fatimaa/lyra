# Shared translation cache (Neon or Supabase connection string). Leave empty locally to use a JSON file.
DATABASE_URL=
# Hosted open model (any OpenAI-compatible API). Groq shown; OpenRouter: https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=
# Optional: TRANSLATORS=llm,ollama,nllb  (order of fallbacks)

# Optional external NLLB server. Leave empty to use http://127.0.0.1:8001 locally.
NLLB_URL=
NLLB_MODEL=

# Optional: lets Lyra find the YouTube video for a song (YouTube Data API v3 key)
YOUTUBE_API_KEY=
